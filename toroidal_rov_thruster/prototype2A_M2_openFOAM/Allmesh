#!/bin/sh
cd "${0%/*}" || exit 1                              # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # OpenFOAM run functions
#------------------------------------------------------------------------------
# Build and check the mesh.   Usage: ./Allmesh [L0|L1|L2]
# Run inside an OpenFOAM shell (start one by typing: openfoam2412).
# Run ./Allclean first when re-meshing: steps with an existing log are skipped.
# Every check is mandatory: the script stops at the first failure.

level="${1:-L0}"

require()   # require <pattern> <log>: stop unless the log contains the pattern
{
    grep -q "$1" "$2" || { echo "CHECK FAILED: '$1' not found in $2"; exit 1; }
}

python3 scripts/configure_mesh.py "$level" || exit 1

# Geometry: units, closed outward shells, envelope, duct clearance, MRF margins.
# Copies geometry/*_p2a.stl to constant/triSurface/.
python3 scripts/validate_geometry.py > log.validateGeometry 2>&1
status=$?
cat log.validateGeometry
[ "$status" -eq 0 ] || exit 1

for part in rotor stator
do
    log="log.surfaceCheck.$part"
    runApplication -s "$part" surfaceCheck -checkSelfIntersection \
        "constant/triSurface/${part}_p2a.stl"
    require "Surface has no illegal triangles." "$log"
    require "Surface is closed." "$log"
    require "Number of unconnected parts : 1$" "$log"
    require "Surface is not self-intersecting" "$log"
done

runApplication blockMesh || exit 1
runApplication surfaceFeatureExtract || exit 1
runApplication snappyHexMesh -overwrite || exit 1
runApplication topoSet || exit 1
require "mrfZone now size [1-9]" log.topoSet
runApplication checkMesh
require "Mesh OK." log.checkMesh

touch case.foam                                     # ParaView opens this file

#------------------------------------------------------------------------------
